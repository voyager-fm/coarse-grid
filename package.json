{
  "name": "coarse-grid",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyager-fm/coarse-grid.git"
  },
  "homepage": "https://voyager-fm.github.io/coarse-grid/",
  "bugs": {
    "url": "https://github.com/voyager-fm/coarse-grid/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --check test/browser/cross-browser.spec.js && node --check test/browser/fixtures.js && node --check test/browser/raster-filter.spec.js && node --check test/package/entry.test.js && node --check playwright.config.js && npx tsc --noEmit",
    "lint:ci": "for f in .github/workflows/*.yml; do js-yaml \"$f\" > /dev/null; done",
    "test:unit": "node --test packages/core/test/*.test.ts test/package/*.test.js",
    "test:browser": "playwright test && node test/browser/compare-browser-results.mjs",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:firefox": "playwright test --project=firefox",
    "test:browser:webkit": "playwright test --project=webkit",
    "test": "pnpm run check && pnpm run test:unit && pnpm run build && pnpm run test:browser"
  },
  "dependencies": {
    "@voyager-fm/coarse-grid-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "regl": "2.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "js-yaml": "^5.3.0",
    "pngjs": "7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "8.1.4"
  }
}
